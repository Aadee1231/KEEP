# Clerk (https://dashboard.clerk.com → your app → API keys → publishable key)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Supabase (https://supabase.com/dashboard → project → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# "demo" runs the whole app on an in-memory store — no backend needed.
# "live" uses Clerk + Supabase. Defaults to demo when the keys above are absent.
EXPO_PUBLIC_DATA_MODE=demo
