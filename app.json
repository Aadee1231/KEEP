{
  "expo": {
    "name": "KEEP",
    "slug": "keep",
    "scheme": "keep",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F1EA",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F4F1EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keep.app",
      "infoPlist": {
        "NSCameraUsageDescription": "KEEP uses the camera so you can submit photo proof for your commitments.",
        "NSPhotoLibraryUsageDescription": "KEEP lets you choose a photo as proof for your commitments."
      }
    },
    "android": {
      "package": "com.keep.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "KEEP uses the camera so you can submit photo proof for your commitments."
        }
      ]
    ]
  }
}
